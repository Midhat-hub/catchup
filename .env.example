# ==============================================================================
# Catchup - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME=Catchup
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL & pgvector Database Settings (Step 1)
POSTGRES_USER=catchup
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=catchup
POSTGRES_HOST=localhost
# Port 5433 is used by default to prevent collision if a local Postgres service is running on 5432
POSTGRES_PORT=5433

# Optional full database URL (overrides individual POSTGRES_* settings if set)
# DATABASE_URL=postgresql://catchup:replace_with_secure_password@localhost:5433/catchup

# GitHub Integration (Step 2 - Read-only Personal Access Token)
# Required for fetching repo files and polling commit history.
# GITHUB_TOKEN=your_github_personal_access_token_here

# LLM Explanation Generation (Step 4 - Gemini Flash / Flash-Lite API Key)
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional override; defaults to Gemini Flash-Lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Delivery / Email Alerts (Step 5 - Recipient address and SMTP settings)
# NOTIFICATION_EMAIL=your_email@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_app_password_here
